{
  "name": "signalcheck",
  "version": "0.5.0",
  "description": "Check your website\u2019s tags and events: GTM, GA4, Meta, Google Ads, TikTok, Snapchat and other tools. Find tracking problems, investigate them and check fixes.",
  "author": "Russ Page (https://github.com/russpage)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install:skill": "node scripts/install.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:runner": "npm --prefix skills/signalcheck/scripts/browser-qa test",
    "setup:runner": "npm --prefix skills/signalcheck/scripts/browser-qa ci --ignore-scripts --no-audit --no-fund",
    "scan": "node skills/signalcheck/scripts/browser-qa/bin/run.mjs",
    "report": "node skills/signalcheck/scripts/browser-qa/bin/report.mjs",
    "actions": "node skills/signalcheck/scripts/browser-qa/bin/actions.mjs",
    "updates": "node skills/signalcheck/scripts/browser-qa/bin/updates.mjs",
    "traffic": "node skills/signalcheck/scripts/browser-qa/bin/traffic.mjs"
  }
}
