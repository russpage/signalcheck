{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignalCheck site contract",
  "type": "object",
  "required": ["pages"],
  "properties": {
    "site": {"type": "string"},
    "pages": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"oneOf": [{"type": "string", "format": "uri"}, {"$ref": "#/$defs/page"}]}},
    "allowedOrigins": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "devices": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "consentStates": {"type": "array", "minItems": 1, "items": {"enum": ["unset", "accepted", "declined"]}},
    "maxVisits": {"type": "integer", "minimum": 1, "maximum": 200},
    "consent": {"type": "object", "properties": {"acceptSelector": {"$ref": "#/$defs/selectors"}, "rejectSelector": {"$ref": "#/$defs/selectors"}}},
    "expectedPageviews": {"$ref": "#/$defs/events"},
    "expectedPageEvents": {"$ref": "#/$defs/events"},
    "knownDestinations": {"type": "object"},
    "collectorHosts": {"type": "object", "additionalProperties": {"enum": ["ga4", "meta", "google_ads"]}},
    "journeys": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/journey"}},
    "syntheticRoutingConfirmed": {"type": "boolean", "default": false},
    "privacySelectors": {"type": "array", "items": {"type": "string"}},
    "captureJourneyScreenshots": {"type": "boolean", "default": false},
    "fullPageScreenshots": {"type": "boolean", "default": false},
    "reportConsoleErrors": {"type": "boolean", "default": false},
    "settleMs": {"type": "integer", "minimum": 500, "maximum": 30000},
    "navigationTimeoutMs": {"type": "integer", "minimum": 5000, "maximum": 120000},
    "timezone": {"type": "string"},
    "locale": {"type": "string"}
  },
  "$defs": {
    "selectors": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "event": {"type": "object", "required": ["vendor", "eventName"], "properties": {"vendor": {"enum": ["ga4", "meta", "google_ads"]}, "destinationId": {"type": "string"}, "eventName": {"type": "string"}, "count": {"type": "integer", "minimum": 0}, "min": {"type": "integer", "minimum": 0}, "max": {"type": "integer", "minimum": 0}, "actionId": {"type": "string"}, "consentStates": {"type": "array", "items": {"type": "string"}}, "devices": {"type": "array", "items": {"type": "string"}}}},
    "form": {"type": "object", "required": ["selector"], "properties": {"id": {"type": "string"}, "selector": {"type": "string"}, "frameSelector": {"type": "string"}, "requiredFields": {"type": "array", "items": {"type": "string"}}, "requireLabels": {"type": "boolean"}}},
    "assertion": {"type": "object", "required": ["selector"], "properties": {"selector": {"type": "string"}, "frameSelector": {"type": "string"}, "visible": {"type": "boolean"}, "enabled": {"type": "boolean"}, "accessibleName": {"type": "string"}}},
    "step": {"type": "object", "required": ["id", "type"], "properties": {"id": {"type": "string"}, "type": {"enum": ["click", "waitForSelector", "waitForUrl"]}, "selector": {"type": "string"}, "frameSelector": {"type": "string"}, "urlPattern": {"type": "string"}, "nonDestructive": {"const": true}, "expectedEvents": {"$ref": "#/$defs/events"}, "settleMs": {"type": "integer", "minimum": 0, "maximum": 10000}}},
    "page": {"type": "object", "required": ["url"], "properties": {"url": {"type": "string", "format": "uri"}, "label": {"type": "string"}, "expectedForms": {"type": "array", "items": {"$ref": "#/$defs/form"}}, "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}}, "expectedEvents": {"$ref": "#/$defs/events"}, "steps": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/step"}}}},
    "journey": {"type": "object", "required": ["id", "url"], "properties": {"id": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "kind": {"enum": ["submission", "invalid-validation"]}, "enabled": {"type": "boolean", "default": false}, "syntheticRoutingConfirmed": {"type": "boolean", "default": false}, "formSelector": {"type": "string"}, "frameSelector": {"type": "string"}, "submitSelector": {"type": "string"}, "validationSelector": {"type": "string"}, "successSelector": {"type": "string"}, "successUrlPattern": {"type": "string"}, "successFrameSelector": {"type": "string"}, "successInTopFrame": {"type": "boolean"}, "fields": {"type": "array", "items": {"type": "object", "required": ["selector"], "properties": {"selector": {"type": "string"}, "type": {"enum": ["text", "select", "checkbox", "radio"]}, "value": {}, "valueEnv": {"type": "string"}}}}, "expectedEvents": {"$ref": "#/$defs/events"}, "blockedReason": {"type": "string"}}}
  }
}
